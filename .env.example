DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/triaige

# Alternativa quando DATABASE_URL não estiver definida:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=triaige
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# true = todas as telas (cases, clients, admin) usam dados mock em memória
# false = cases/clients usam a API MySQL; telas admin sem API ficam vazias/indisponíveis
NEXT_PUBLIC_USE_MOCK_DATA=false

