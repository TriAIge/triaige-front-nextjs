DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/triaige

# Alternativa quando DATABASE_URL não estiver definida.
# O banco é o mesmo do triaige-srv-orchestrator: DB_NAME precisa ser igual ao dele
# (schema canônico do triaige-infra; o orchestrator usa triaige_srv_orchestrator por padrão).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=triaige
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# true = todas as telas usam dados mock em memória e não exigem login
# false = telas usam a API e o MySQL
NEXT_PUBLIC_USE_MOCK_DATA=false

# Leitura do relatório da IA (relatorio.json no bucket curated) para criticidade, prazo e resumo do caso.
# Credenciais pela cadeia padrão da AWS (variáveis abaixo, perfil, role da instância/tarefa).
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Endpoint alternativo (ex.: LocalStack em http://localhost:4566), o mesmo do orchestrator
AWS_S3_ENDPOINT=

# Tempo médio de triagem manual (minutos) usado no indicador "Horas economizadas" do portal
MANUAL_TRIAGE_MINUTES=15

# URL do Grafana interno para o atalho em /admin/observabilidade
NEXT_PUBLIC_GRAFANA_URL=
